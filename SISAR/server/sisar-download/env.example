# sisar/download — env.example
# Copy to .env and fill in your values before running docker compose.

# Absolute path to the job working directory on the host.
# Must contain specification.toml and burst_list.json before the container starts.
JOB_DIR=/data/sisar/jobs/<job-uuid>

# Absolute path to the shared burst archive on the host.
ARCHIVE_DIR=/data/sisar/archive

# NASA Earthdata credentials.
# Alternatively, you may bind-mount a ~/.netrc containing a machine entry for
# urs.earthdata.nasa.gov and leave these blank.
EARTHDATA_USER=
EARTHDATA_PASS=
