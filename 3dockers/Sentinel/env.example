# env.example — sisar/download-s1
# Copiar a .env y completar los valores antes de correr docker compose.

# Ruta absoluta al directorio de trabajo del job en el host.
# Debe contener burst_list.json y burst_stitch/*.json antes de iniciar.
JOB_DIR=/data/sisar/jobs/<job-uuid>

# Ruta absoluta al archive compartido de bursts en el host.
ARCHIVE_DIR=/data/sisar/archive

# Credenciales NASA Earthdata.
# Alternativa: bind-mount de un ~/.netrc con la entrada para
# urs.earthdata.nasa.gov y dejar estos valores en blanco.
EARTHDATA_USER=
EARTHDATA_PASS=

# Workers de descarga paralela (default: 4).
# Reducir a 1 para debug o si Earthdata empieza a throttlear.
DOWNLOAD_CONCURRENCY=4
